.itil-pd-wrapper {
	background: #090d16;
	color: #f8fafc;
	min-height: 100vh;
}

.itil-pd-container {
	padding: 20px;
	font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

.itil-pd-header-nav {
	margin-bottom: 16px;
}

.itil-pd-header-card {
	background: #1e293b;
	border: 1px solid #334155;
	border-radius: 10px;
	padding: 24px;
	margin-bottom: 20px;
	display: flex;
	justify-content: space-between;
	align-items: center;
}

.itil-pd-header-main {
	display: flex;
	align-items: center;
	gap: 18px;
}

.itil-pd-icon-box {
	font-size: 32px;
	color: #38bdf8;
	background: #0f172a;
	padding: 16px;
	border-radius: 12px;
	border: 1px solid #334155;
}

.itil-pd-group-badge {
	display: inline-block;
	font-size: 11px;
	text-transform: uppercase;
	letter-spacing: 0.8px;
	background: #0284c7;
	color: #ffffff;
	padding: 3px 8px;
	border-radius: 4px;
	margin-bottom: 6px;
}

.itil-pd-header-text h1 {
	font-size: 24px;
	font-weight: 700;
	margin: 0 0 6px 0;
	color: #f8fafc;
}

.itil-pd-header-text p {
	font-size: 13px;
	color: #94a3b8;
	margin: 0;
}

.itil-pd-header-meta {
	font-size: 12px;
	color: #64748b;
}

.itil-pd-header-meta span {
	color: #38bdf8;
	font-weight: 600;
}

.itil-pd-metrics-grid {
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	gap: 16px;
	margin-bottom: 20px;
}

.itil-pd-metric-card {
	background: #1e293b;
	border: 1px solid #334155;
	border-radius: 10px;
	padding: 16px;
}

.itil-pd-metric-label {
	font-size: 11px;
	text-transform: uppercase;
	color: #94a3b8;
	letter-spacing: 0.5px;
}

.itil-pd-metric-value {
	font-size: 26px;
	font-weight: 700;
	margin: 6px 0;
	color: #f8fafc;
}

.itil-pd-metric-value.text-primary { color: #38bdf8; }
.itil-pd-metric-value.text-success { color: #34d399; }
.itil-pd-metric-value.text-warning { color: #fbbf24; }

.itil-pd-metric-sub {
	font-size: 11px;
	color: #64748b;
}

.itil-pd-actions-bar {
	display: flex;
	gap: 12px;
	margin-bottom: 20px;
	background: #1e293b;
	padding: 12px 16px;
	border-radius: 8px;
	border: 1px solid #334155;
}

.itil-pd-card {
	background: #1e293b;
	border: 1px solid #334155;
	border-radius: 10px;
	padding: 20px;
	margin-bottom: 20px;
}

.itil-pd-card h3 {
	font-size: 16px;
	font-weight: 600;
	margin-top: 0;
	margin-bottom: 16px;
	color: #f8fafc;
}

.table-dark-custom {
	background: #0f172a;
	color: #f8fafc;
	border-color: #334155;
}

.table-dark-custom th {
	background: #1e293b;
	border-color: #334155;
	color: #94a3b8;
	font-size: 12px;
	text-transform: uppercase;
}

.table-dark-custom td {
	border-color: #334155;
	font-size: 13px;
}

.itil-pd-link {
	color: #38bdf8;
	font-weight: 600;
	cursor: pointer;
	text-decoration: none;
}

.itil-pd-link:hover {
	text-decoration: underline;
}

.itil-pd-empty-state {
	padding: 24px;
	text-align: center;
	color: #64748b;
	font-size: 13px;
}

.itil-pd-phase2-card {
	background: #0f172a;
	border: 1px dashed #334155;
	border-radius: 8px;
	padding: 24px;
	text-align: center;
	color: #94a3b8;
}

.itil-pd-phase2-icon {
	font-size: 28px;
	color: #0284c7;
	margin-bottom: 8px;
}

.itil-pd-phase2-card h4 {
	font-size: 15px;
	color: #f8fafc;
	margin-bottom: 6px;
}

.itil-pd-error-card {
	background: #1e293b;
	border: 1px solid #ef4444;
	border-radius: 10px;
	padding: 32px;
	text-align: center;
	margin-top: 40px;
}

.itil-pd-error-card h3 {
	color: #ef4444;
	margin-bottom: 12px;
}

.itil-pd-error-card p {
	color: #94a3b8;
	margin-bottom: 20px;
}

@media (max-width: 768px) {
	.itil-pd-metrics-grid {
		grid-template-columns: repeat(2, 1fr);
	}
	.itil-pd-header-card {
		flex-direction: column;
		align-items: flex-start;
		gap: 16px;
	}
}
