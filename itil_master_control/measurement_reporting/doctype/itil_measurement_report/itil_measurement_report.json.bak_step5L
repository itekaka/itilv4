   "fieldtype": "Section Break",
   "label": "Measurement Information"
  },
  {
   "fieldname": "measurement_name",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Measurement / Report Name",
   "reqd": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Status",
   "options": "Draft\nPublished\nReviewed\nArchived",
   "default": "Draft"
  },
  {
   "fieldname": "measurement_owner",
   "fieldtype": "Link",
   "label": "Measurement Owner",
   "options": "User"
  },
  {
   "fieldname": "reporting_period",
   "fieldtype": "Select",
   "label": "Reporting Period",
   "options": "Daily\nWeekly\nMonthly\nQuarterly\nSemi-Annual\nAnnual"
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Description"
  },
  {
   "fieldname": "measurement_definition_section",
   "fieldtype": "Section Break",
   "label": "Measurement Definition"
  },
  {
   "fieldname": "metric",
   "fieldtype": "Data",
   "label": "Metric / KPI"
  },
  {
   "fieldname": "target_value",
   "fieldtype": "Float",
   "label": "Target Value"
  },
  {
   "fieldname": "actual_value",
   "fieldtype": "Float",
   "label": "Actual Value"
  },
  {
   "fieldname": "unit",
   "fieldtype": "Data",
   "label": "Unit"
  },
  {
   "fieldname": "performance_section",
   "fieldtype": "Section Break",
   "label": "Performance & Findings"
  },
  {
   "fieldname": "performance_status",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Performance Status",
   "options": "On Target\nAt Risk\nBelow Target\nNot Measured",
   "default": "Not Measured"
  },
  {
   "fieldname": "findings",
   "fieldtype": "Text Editor",
   "label": "Findings"
  },
  {
   "fieldname": "actions",
   "fieldtype": "Text Editor",
   "label": "Required Actions"
  }
 ],
 "index_web_pages_for_search": 1,
